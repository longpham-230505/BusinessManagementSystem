{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abms",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Chạy Worker gần database (Neon) thay vì gần người dùng: mỗi trang cần vài query tuần tự.
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Thay bằng id lấy từ: npx wrangler hyperdrive create abms --connection-string="<DIRECT_URL của Neon>"
			"id": "2317d9661587421fa947d9f59959881a",
			// Chuỗi kết nối GIẢ (không phải database thật, không chứa mật khẩu). Wrangler bắt buộc có
			// một chuỗi local cho binding Hyperdrive mỗi khi khởi động proxy local — `opennextjs-cloudflare
			// deploy` (bước deploy trên Cloudflare Workers Builds) cũng làm vậy dù không truy vấn gì.
			// Chuỗi này KHÔNG được deploy lên Worker. Muốn chạy preview local với database thật, đặt biến
			// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (biến môi trường được ưu tiên hơn).
			"localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
		}
	],
	// Bản preview (build của nhánh không phải production, vd. nhánh của pull request) cần khối
	// "previews" riêng. Hiện chỉ có MỘT database Neon (dùng để test) nên preview dùng chung
	// Hyperdrive với production. Khi có database/branch Neon riêng cho preview, tạo Hyperdrive mới
	// và thay id bên dưới để preview không đụng dữ liệu thật.
	"previews": {
		"hyperdrive": [
			{
				"binding": "HYPERDRIVE",
				"id": "2317d9661587421fa947d9f59959881a"
			}
		],
		"placement": {
			"mode": "smart"
		}
	}
	// Secret (SESSION_SECRET) đặt bằng: npx wrangler secret put SESSION_SECRET
	// (preview dùng secret riêng, đặt trong Cloudflare dashboard → Settings → Variables and Secrets).
}