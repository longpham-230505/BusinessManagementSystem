# Neon — xem Implementation Plan mục 3.1
# Pooled connection (dùng lúc app chạy ở local; trên Cloudflare Workers dùng binding Hyperdrive)
# sslmode=verify-full là hành vi hiện tại của driver `pg` khi ghi require — ghi rõ để không có cảnh báo.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=verify-full"
# Direct connection, không qua pooler (dùng cho migrate, scripts/backup và tạo Hyperdrive)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full"

# Chuỗi ngẫu nhiên dài dùng để ký session cookie. Tạo bằng:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-base64-string"
