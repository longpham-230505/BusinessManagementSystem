# Neon — xem Implementation Plan mục 3.1
# Pooled connection (dùng lúc app chạy)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require"
# Direct connection, không qua pooler (dùng cho migrate và cho scripts/backup)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Chuỗi ngẫu nhiên dài dùng để ký session cookie. Tạo bằng:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-base64-string"
